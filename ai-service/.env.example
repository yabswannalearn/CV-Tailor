# Local Postgres (use Supabase's connection pooler URL in production):
DATABASE_URL=postgresql://postgres:password@localhost:5432/cv_tailor

GEMINI_API_KEY=your-gemini-api-key
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://cvtailor.me
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CV Tailor <no-reply@cvtailor.me>
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000

# Creates database tables on startup if they don't exist.
# Safe to leave on for local dev (create_all is idempotent).
AUTO_CREATE_TABLES=true

# Bound database waits so an unreachable production database fails quickly.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
