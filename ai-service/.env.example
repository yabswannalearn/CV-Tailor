# Local Postgres. For a persistent production backend, prefer Supabase's
# session pooler URL (aws-REGION.pooler.supabase.com:5432) when IPv4 is needed.
# Use transaction mode (:6543) only for short-lived/serverless processes.
DATABASE_URL=postgresql://postgres:password@localhost:5432/cv_tailor

# AI provider switch: "openai" or "gemini". Both stay configured so you can
# swap providers by changing AI_PROVIDER alone.
AI_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite-preview
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://cvtailor.me
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CV Tailor <no-reply@cvtailor.me>
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000

# Creates database tables on startup if they don't exist.
# Safe to leave on for local dev (create_all is idempotent).
AUTO_CREATE_TABLES=true

# Bound database waits so an unreachable production database fails quickly.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500
