# Local Postgres (default for local development):
DATABASE_URL=postgresql://postgres:password@localhost:5432/cv_tailor

GEMINI_API_KEY=your-gemini-api-key
SESSION_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000

# Creates database tables on startup if they don't exist.
# Safe to leave on for local dev (create_all is idempotent).
AUTO_CREATE_TABLES=true
